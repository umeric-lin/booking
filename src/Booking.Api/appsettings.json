{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Booking": "Data Source=booking.db;Default Timeout=30"
  },
  "Jwt": {
    "Issuer": "RoomBookingApi",
    "Audience": "RoomBookingClients",
    "SigningKey": "development-only-signing-key-change-me-0123456789abcdef",
    "TokenLifetimeMinutes": 60,
    "DevApiKey": "local-dev-key"
  }
}